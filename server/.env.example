# ── Server ──────────────────────────────
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback
AUTH_ERROR_REDIRECT_URL=http://localhost:3000/auth/error
COOKIE_SIGNING_SECRET=replace_with_a_long_random_secret

# ── Supabase ────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional for milestone 1 (required later for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_AUDIENCE=authenticated
# Optional; defaults to ${SUPABASE_URL}/auth/v1 if omitted
SUPABASE_JWT_ISSUER=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5000/auth/oauth/google/callback

# ── PostgreSQL ───────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/rehearse_db
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000

# ── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379
# Use Redis-backed rate limit store only when Redis is stable.
# Default behavior: enabled in production, disabled in development.
RATE_LIMIT_REDIS_ENABLED=false

# ── Groq ─────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# STT model: whisper-large-v3 or whisper-large-v3-turbo
GROQ_STT_MODEL=whisper-large-v3-turbo
# TTS model and voices
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE_MALE=troy
GROQ_TTS_VOICE_FEMALE=sara
# Optional reliability tuning
GROQ_STREAM_TIMEOUT_MS=30000
GROQ_COMPLETION_TIMEOUT_MS=15000
# Quota control (Redis-backed, per model)
GROQ_QUOTA_ENABLED=true
# If Redis is unavailable, continue requests without quota blocking.
GROQ_QUOTA_FAIL_OPEN=true
# Use 1-100. 100 means use full provider quota; 80 leaves safety headroom.
GROQ_QUOTA_HEADROOM_PERCENT=100
# Approximate byte rate for webm/ogg voice uploads (for STT ASH/ASD tracking).
GROQ_AUDIO_BYTES_PER_SECOND_ESTIMATE=6000
